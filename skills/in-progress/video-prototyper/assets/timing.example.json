  {
   "id": "c01",
   "scene": 1,
   "text": "It's your first week in Alder Creek, and the kitchen counter is filling up.",
   "start": 0.0,
   "end": 4.01
  },
  {
   "id": "c02",
   "scene": 1,
   "text": "A pizza box, a yogurt cup, apple peels, a glass jar.",
   "start": 4.01,
   "end": 8.42
  },
  {
   "id": "c03",
   "scene": 1,
   "text": "Where does each one go?",
   "start": 8.42,
   "end": 9.703
  },
  {
   "id": "c04",
   "scene": 2,
   "text": "Alder Creek uses three bins.",
   "start": 10.4,
   "end": 12.41
  },
  {
   "id": "c05",
   "scene": 2,
   "text": "The blue bin takes clean paper, cans and bottles.",
   "start": 12.41,
   "end": 15.3
  },
  {
   "id": "c06",
   "scene": 2,
   "text": "The green bin takes food scraps and yard trimmings.",
